#!/usr/bin/env python3
"""
aw-workspace-cli — this workspace's own CLI. Named ``aw-workspace-cli`` (not
``aw``) so it can't be confused with the monolith's ``./aw`` — an LLM/agent
that has both on PATH would otherwise conflate two very different tools.

Commands are auto-discovered from two places — ``src/cli/commands/*.py``
(built into this repo) and ``<apps_root>/<slug>/commands/*.py`` (one per
installed app, so each app ships and owns its own CLI surface with no
change needed here). Drop a file with ``COMMAND``, ``DESCRIPTION``, and
``run(args) -> int`` in either location and it becomes available
immediately — see ``src/cli/discovery.py``.

Usage:
    aw-workspace-cli <command> [args...]
    aw-workspace-cli help
"""
import os
import sys

# This script lives at <repo>/aw-workspace-cli (repo root, where src/ lives).
# Agent-runner containers additionally bind-mount this same file a second
# time at /usr/local/bin/aw-workspace-cli (a real copy, not a symlink, so
# realpath(__file__) resolves to THAT path there, not back to the repo root)
# so the bare command works on PATH from any cwd — fall back to the
# well-known workspace root when that happens.
BASE_DIR = os.path.dirname(os.path.realpath(__file__))
if not os.path.isfile(os.path.join(BASE_DIR, "src", "cli", "discovery.py")):
    BASE_DIR = "/opt/aw-workspace"
sys.path.insert(0, BASE_DIR)

from src.cli.discovery import discover_commands  # noqa: E402


def main() -> int:
    commands = discover_commands()

    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        name, rest = "help", []
    else:
        name, rest = sys.argv[1], sys.argv[2:]
    module = commands.get(name)
    if module is None:
        print(f"aw-workspace-cli: unknown command '{name}'")
        print("Run 'aw-workspace-cli help' to list available commands.")
        return 1

    return module.run(rest) or 0


if __name__ == "__main__":
    sys.exit(main())
