# Which workspace this process serves, and its dedicated Postgres schema
# (provisioned centrally by aw-backend's workspace_provisioner, F1 —
# CREATE SCHEMA workspace_<slug>). schema_translate_map routes every
# unqualified table this process touches into AW_WORKSPACE_SCHEMA.
AW_WORKSPACE=demo
AW_WORKSPACE_SCHEMA=workspace_demo

AW_PORT=9030
AW_WORKSPACE_WORKERS=2

# Shared Postgres — same server as aw-backend/awserv (managed) or a local/BYO
# instance. Normal postgresql:// or postgresql+psycopg:// both accepted.
AWSERV_DB_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/awserv

# Offline EdDSA identity verification (see src/api/identity.py). Provide
# EITHER the public key PEM directly, OR the aw-backend base URL to fetch
# it from once at first use (GET /api/identity/public-key).
AW_BACKEND_URL=https://api.aw.tekflox.com
AW_AUTH_PUBLIC_KEY=
