{
  "manifest_version": 1,
  "id": "hello",
  "name": "Hello App",
  "version": "1.0.0",
  "description": "F1 proof-of-concept: a hot-installed app that ships a backend route and a declarative window body.",
  "tier": "inprocess",
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "plugin:HelloPlugin"
  },
  "permissions": [
    "routes:register"
  ],
  "contributes": {
    "routes": [{ "prefix": "/api/apps/hello" }],
    "windows": [
      {
        "id": "hello.main",
        "title": "Hello App",
        "body": { "type": "declarative", "spec": "windows/main.json" }
      }
    ],
    "nav": [
      { "id": "hello.nav", "label": "Hello", "icon": "sparkles", "opens": "hello.main" }
    ]
  }
}
